# === LOCAL DEV ===
FIREBASE_CREDENTIALS=kairo-firebase-credentials.json
FIREBASE_STORAGE_BUCKET=kairo-reader.firebasestorage.app
AUTH_CODE=password123

# === PRODUCTION (set these as env vars on your host) ===
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# FIREBASE_STORAGE_BUCKET=kairo-reader.firebasestorage.app
# AUTH_CODE=your-strong-secret-here
# CORS_ORIGINS=https://your-netlify-app.netlify.app
CORS_ORIGINS=https://kairo-reader.netlify.app,http://localhost:5173

# Patreon OAuth
PATREON_CLIENT_ID=your-patreon-client-id
PATREON_CLIENT_SECRET=your-patreon-client-secret
PATREON_REDIRECT_URI=https://kairo-back.onrender.com/api/auth/patreon/callback
PATREON_CAMPAIGN_ID=your-campaign-id
FRONTEND_URL=https://kairo-reader.netlify.app